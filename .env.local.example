# Copy this file to .env.local and fill in the values for local development.

# Neon pooled connection string.
# On Vercel this is injected automatically by the Neon Marketplace integration —
# you do NOT set it manually in production.
DATABASE_URL=

# Admin credentials for the /admin dashboard (checked server-side only).
ADMIN_USERNAME=siiri
ADMIN_PASSWORD=Pidu45!

# Token stored in the httpOnly admin session cookie. Use any long random string,
# e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=
